rule exonIntervals:
    input:
        asmbly = join(OUT_DIR, 'StringTie', '{genome}', 'stringtie_merged.gtf')
    output:
        exons_bed = join(OUT_DIR, 'ASEReadCounter_star', '{genome}', 'vcf_out', 'EXONS.bed')
    log:
        join(OUT_DIR, 'Logs','ASEReadCounter_star', '{genome}', 'exons_bed.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks','ASEReadCounter_star', '{genome}', 'exons_bed.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    message:
        """--- Extracting exon coordinates for {wildcards.genome} genome"""
    run:
        shell('awk \'$3=="exon"\' {input.asmbly} | cut -f1,4,5,9 | awk -F $"\t" \'BEGIN {{OFS = FS}} {{split($4, a, "gene_id \\""); split(a[2], b, "\\""); print $1, $2-1, $3, b[1]}}\' > {output.exons_bed}')

##--------------------------------------------------------------------------------------##
##--------------------------------------------------------------------------------------##

rule HaplotypeCaller:
    input:
        bam = join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.duprem.split.hisat2.bam'),
        exons_bed = join(OUT_DIR, 'ASEReadCounter_star', '{genome}', 'vcf_out', 'EXONS.bed')
    output:
        vcf = join(OUT_DIR, 'GATK', '{genome}', '{sample}_{genome}.haplo.SNP.vcf.gz'),
    params:
        fasta = lambda wildcards: config['genomes'][wildcards.genome]['fasta']
    log:
        join(OUT_DIR, 'Logs', 'HaplotypeCaller', '{sample}_{genome}_haplo.log') 
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'HaplotypeCaller', '{sample}_{genome}_haplo.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    message:
        """--- Calling variants for sample {wildcards.sample} with {wildcards.genome} mapping """
    conda:
        'envs/gatk.yml'
    shell:
        """
        gatk HaplotypeCaller -R {params.fasta} -I {input.bam} -O {output.vcf} -L {input.exons_bed} \
            -stand-call-conf 20 -dont-use-soft-clipped-bases -ERC GVCF > {log} 2>&1
        """

##--------------------------------------------------------------------------------------##
##--------------------------------------------------------------------------------------##

rule GenotypeGVCFs:
    input:
        vcf = join(OUT_DIR, 'GATK', '{genome}', '{sample}_{genome}.haplo.SNP.vcf.gz')
    output:
        vcf = join(OUT_DIR, 'GATK', '{genome}', '{sample}_{genome}.genotype_SNP.vcf.gz'),
    params:
        fasta = lambda wildcards: config['genomes'][wildcards.genome]['fasta']
    log:
        join(OUT_DIR, 'Logs', 'GenotypeGVCFs', '{sample}_{genome}_genoVCF.log') 
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'GenotypeGVCFs', '{sample}_{genome}_genoVCF.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    message:
        """--- Calling genotypes for sample {wildcards.sample} with {wildcards.genome} mapping """
    conda:
        'envs/gatk.yml'
    shell:
        """
        gatk GenotypeGVCFs -R {params.fasta} -V {input.vcf} -O {output.vcf} --max-alternate-alleles 4 \
            --standard-min-confidence-threshold-for-calling 30 -all-sites > {log} 2>&1
        """

##--------------------------------------------------------------------------------------##
##--------------------------------------------------------------------------------------##

rule VariantFiltration:
    input:
        vcf = join(OUT_DIR, 'GATK', '{genome}', '{sample}_{genome}.genotype_SNP.vcf.gz')
    output:
        vcf = join(OUT_DIR, 'GATK', '{genome}', '{sample}_{genome}.genotype_SNP.filtered.vcf'),
    params:
        fasta = lambda wildcards: config['genomes'][wildcards.genome]['fasta']
    log:
        join(OUT_DIR, 'Logs', 'GenotypeGVCFs', '{sample}_{genome}_genoVCF.log') 
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'GenotypeGVCFs', '{sample}_{genome}_genoVCF.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    message:
        """--- Filtering variants for sample {wildcards.sample} with {wildcards.genome} mapping """
    conda:
        'envs/gatk.yml'
    shell:
        """
        gatk VariantFiltration -R {params.fasta} -V {input.vcf} -O {output.vcf} --window 35 --cluster 3 --filter-name "DP" --filter "DP < 5" \
            --filter-name "FS" --filter "FS > 30.0" --filter-name "QD" --filter "QD < 2.0" > {log} 2>&1
        """

