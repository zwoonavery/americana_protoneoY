##--------------------------------------------------------------------------------------##

rule aggregate_ase_by_feature:
    input:
        gtf = join(OUT_DIR, "StringTie", "{genome}", "stringtie_merged.gtf"),
        ase = join(OUT_DIR, 'GATK', '{genome}', '{sample}_{genome}.SNP.ASE.RNAFixed.ALL.output.table'),
    output:
        snp_by_feature = join(
            OUT_DIR,
            "ASE_feature",
            "{sample}_{genome}.snp_by_{ASE_LEVEL}.tsv",
        ),
        ase_by_feature = join(
            OUT_DIR,
            "ASE_feature",
            "{sample}_{genome}.ase_by_{ASE_LEVEL}.tsv",
        ),
    params:
        prefix = lambda wc, output: output.snp_by_feature.replace(
            f".snp_by_{ASE_LEVEL}.tsv", ""
        ),
        level = lambda wc: config["ase_aggregation"]["level"],
        feature_type = lambda wc: config["ase_aggregation"]["feature_type"],
        agg = lambda wc: config["ase_aggregation"]["aggregation"],
        min_total_count = lambda wc: config["ase_aggregation"]["min_total_count"],
    conda:
        "envs/ase_aggregation.yml"
    threads:
        2
    message:
        "Aggregating ASE for {wildcards.sample} on {wildcards.genome} at {params.level} level"
    shell:
        """
        mkdir -p $(dirname {output.snp_by_feature})
        aggregate_ase_by_feature.py --gtf {input.gtf}--ase {input.ase} --level {params.level} --feature-type {params.feature_type} \
            --agg {params.agg} --min-total-count {params.min_total_count} -o {params.prefix}
        """

