## Final expected output(s)
rule all:
    input:
        expand(join(OUT_DIR, "ASE_feature", "{sample}_{genome}.snp_by_" + ASE_LEVEL + ".tsv", ), genome=config['genomes'], sample=SAMPLES),
        join(OUT_DIR, 'MultiQC', 'multiqc_report.html'),

