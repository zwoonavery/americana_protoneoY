rule SelectVariants:
    input:
        vcf = join(OUT_DIR, 'GATK', '{genome}', '{sample}_{genome}.genotype_SNP.filtered.vcf')
    output:
        vcf = join(OUT_DIR, 'GATK', '{genome}', '{sample}_{genome}.genotype_SNP.filtered.PASS.vcf'),
    params:
        fasta = lambda wildcards: config['genomes'][wildcards.genome]['fasta']
    log:
        join(OUT_DIR, 'Logs', 'SelectVariants', '{sample}_{genome}_selVar.log') 
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'SelectVariants', '{sample}_{genome}_selVar.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    message:
        """--- Selecting variants for sample {wildcards.sample} with {wildcards.genome} mapping """
    conda:
        'envs/gatk.yml'
    shell:
        """
        gatk SelectVariants -V {input.vcf} -O {output.vcf} --exclude-filtered --restrict-alleles-to BIALLELIC --select-type-to-include SNP > {log} 2>&1
        """

