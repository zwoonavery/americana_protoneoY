    log:
        join(OUT_DIR, 'Logs', 'SplitCigR', '{sample}_{genome}_splitcigar.log') 
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'SplitCigR', '{sample}_{genome}_splitcigar.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    message:
        """--- Splitting N CIGAR reads for sample {wildcards.sample} with {wildcards.genome} mapping """
    conda:
        'envs/gatk.yml'
    shell:
        """
        gatk SplitNCigarReads -R {params.fasta} -I {input.bam} -O {output.bam}
        """

