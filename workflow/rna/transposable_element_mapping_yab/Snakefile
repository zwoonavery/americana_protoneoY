rule SplitNCigarReads:
    input:
        bam = join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.duprem.hisat2.bam')
    output:
        bam = join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.duprem.split.hisat2.bam'),
    params:
