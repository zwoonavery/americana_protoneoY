rule MarkDuplicates:
    input:
        bam = join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.hisat2.bam')
    output:
        bam = temp(join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.duprem.hisat2.bam'))
    log:
        stdout = join(OUT_DIR, 'Logs', 'MarkDups', '{sample}_{genome}_markdups.log'),
        metrics = join(OUT_DIR, 'Benchmarks', 'MarkDups', '{sample}_{genome}_metrics.benchmark.tsv')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'MarkDups', '{sample}_{genome}_markdups.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    message:
        """--- Marking and removing duplicates for sample {wildcards.sample} with {wildcards.genome} mapping """
    conda:
        'envs/atac_yablab.yml'
    shell:
        'picard -Xmx{resources.mem_mb}m MarkDuplicates'
                ' -I {input.bam}'
                ' --MAX_RECORDS_IN_RAM 2000000'
                ' -O {output.bam}'
                ' -M {log.metrics}'
                ' --TMP_DIR ' + join(OUT_DIR, 'Temp', 'picard', '{wildcards.genome}', '{wildcards.sample}') +
                ' --REMOVE_DUPLICATES true'
                ' > {log.stdout} 2>&1'


