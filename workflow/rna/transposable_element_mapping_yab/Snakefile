##--------------------------------------------------------------------------------------##

rule ASEReadCounter:
    input:
        bam = join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.duprem.split.hisat2.bam'),
        vcf = join(OUT_DIR, 'GATK', '{genome}', '{sample}_{genome}.genotype_SNP.filtered.PASS.vcf')
    output:
        ase = join(OUT_DIR, 'GATK', '{genome}', '{sample}_{genome}.SNP.ASE.RNAFixed.ALL.output.table'),
    params:
        fasta = lambda wildcards: config['genomes'][wildcards.genome]['fasta']
    log:
        join(OUT_DIR, 'Logs', 'SelectVariants', '{sample}_{genome}_selVar.log') 
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'SelectVariants', '{sample}_{genome}_selVar.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    message:
        """--- Counting allele-specific reads for sample {wildcards.sample} with {wildcards.genome} mapping """
    conda:
        'envs/gatk.yml'
    shell:
        """
        gatk ASEReadCounter -R {params.fasta} -I {input.bam} -V {input.vcf} -O {output.ase} --disable-sequence-dictionary-validation > {log} 2>&1
        """

