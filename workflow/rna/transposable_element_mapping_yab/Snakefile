rule qualimap:
    input:
        # BAM aligned, splicing-aware, to reference genome
        bam = join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.hisat2.bam'),
        bai = join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.hisat2.bam.bai'),
        # GTF containing transcript, gene, and exon data
        gtf = lambda wildcards: config['genomes'][wildcards.genome]['gtf']
    output:
        directory(join(OUT_DIR, 'QC', '{genome}', '{sample}_{genome}_qualimap'))
    params:
        extra="--java-mem-size=32G -pe --outformat PDF"
    log:
        join(OUT_DIR, 'Logs', 'qualimap', 'qualmap_{sample}_{genome}.log')
    # optional specification of memory usage of the JVM that snakemake will respect with global
    # resource restrictions (https://snakemake.readthedocs.io/en/latest/snakefiles/rules.html#resources)
    # and which can be used to request RAM during cluster job submission as `{resources.mem_mb}`:
    # https://snakemake.readthedocs.io/en/latest/executing/cluster.html#job-properties
    wrapper:
        "v3.1.0/bio/qualimap/rnaseq"

##--------------------------------------------------------------------------------------##
##--------------------------------------------------------------------------------------##

rule stringtie:
    input:
        bam = join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.hisat2.bam')
    output:
        asmbly = temp(join(OUT_DIR, 'StringTie', '{genome}', '{sample}_{genome}.gtf'))
    params:
        gtf = lambda wildcards: config['genomes'][wildcards.genome]['gtf']
    log:
        join(OUT_DIR, 'Logs', 'stringtie', 'stringtie_{sample}_{genome}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'stringtie', 'stringtie_{sample}_{genome}.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    message:
        """--- Assembling transcripts for sample {wildcards.sample} with StringTie """
    conda:
        'envs/rnaseq_yablab.yml'
    shell:
        'stringtie'
                ' {input.bam}'
                ' -p 8'
                # ' -G {params.gtf}'
                ' -o {output.asmbly}'
                ' -l {wildcards.sample} > {log} 2>&1'

##--------------------------------------------------------------------------------------##
##--------------------------------------------------------------------------------------##

rule merge_assemblies:
    input:
        assemblies = expand(join(OUT_DIR, 'StringTie', '{genome}', '{sample}_{genome}.gtf'), sample = SAMPLES, genome = config['genomes'])
    output:
        asmbly = join(OUT_DIR, 'StringTie', '{genome}', 'stringtie_merged.gtf'),
        geneTransMap = join(OUT_DIR, 'StringTie', '{genome}', 'stringtie_merged_gene_trans_map')
    params:
        gtf = lambda wildcards: config['genomes'][wildcards.genome]['gtf']
    log:
        join(OUT_DIR, 'Logs', 'stringtie', 'st_mrg_{genome}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'stringtie', 'st_mrg_{genome}.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    message:
        """--- Merging StringTie transcripts for genome mapping {wildcards.genome}"""
    conda:
        'envs/rnaseq_yablab.yml'
    shell:
        'ls -1 ' + join(OUT_DIR, 'StringTie', '{wildcards.genome}', '*.gtf') + ' > ' + join(OUT_DIR, 'StringTie', '{wildcards.genome}', 'assemblies.txt') + 
        ' && stringtie'
                ' --merge'
                ' -p 8'
                # ' -G {params.gtf}'
                ' -o {output.asmbly} ' + join(OUT_DIR, 'StringTie', '{wildcards.genome}', 'assemblies.txt') +
        ' && awk \'{{if ($3 == "transcript") print $10"\t"$12}}\' {output.asmbly} | sed "s/;//g" | sed "s/\\\"//g" | sort -u > {output.geneTransMap}'

##--------------------------------------------------------------------------------------##
##--------------------------------------------------------------------------------------##

rule repeatmasker:
    input:
        fasta = lambda wildcards: config['genomes'][wildcards.genome]['fasta'],
        asmbly = join(OUT_DIR, 'StringTie', '{genome}', 'stringtie_merged.gtf')
    output:
        folder = directory(join(OUT_DIR, 'RepeatMasker', '{genome}')),
        fasta = join(OUT_DIR, 'RepeatMasker', '{genome}_RM_TEs.fasta'),
        gtf = join(OUT_DIR, 'RepeatMasker', '{genome}_RM_TEs.gtf')
    log:
        join(OUT_DIR, 'Logs', 'repeatmasker', '{genome}.log')
    params:
        te_lib = lambda wildcards: config['genomes'][wildcards.genome]['te_fasta'] 
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'repeatmasker', '{genome}.benchmark.tsv')
    threads:
        16
    resources:
        mem_mb=16000,
        repeatmasker_db=1       # <-- mutex for the library build
    message:
        """--- Masking repeates for {wildcards.genome} genome """
    conda:
        'envs/repeatmasker.yml'
    shell:
        (
        'RepeatMasker'
        ' -e ncbi'
        ' -q'
        ' -no_is'
        ' -nolow'
        ' -gff'
        ' -lib {params.te_lib}'
        ' -dir {output.folder}'
        ' {input.fasta}'
        ' > {log} 2>&1'
        ' && cat ' + join(OUT_DIR, 'RepeatMasker', '{wildcards.genome}', '*.masked') + ' {params.te_lib} > {output.fasta}'
        ' && awk \'/^>/ {{if (seqlen){{print seqlen}}; print ;seqlen=0;next; }} {{ seqlen += length($0)}}END{{print seqlen}}\' {params.te_lib} | tr \'\\n\' \'\\t\' | sed "s/$/\\n/g" | tr \'>\' \'\\n\' | awk \'{{print $1"\\tRepeatMasker\\texon\\t1\\t"$4"\\t.\\t+\\t.\\tgene_id \\""$1"\\"; gene_name \\""$1"\\"; gene_biotype \\"protein_coding\\";"}}\' | sed 1d | cat {input.asmbly} - > {output.gtf}'
        )

##--------------------------------------------------------------------------------------##
##--------------------------------------------------------------------------------------##

rule RM_seqDictionary:
    input:
        fasta = join(OUT_DIR, 'RepeatMasker', '{genome}_RM_TEs.fasta')
    output:
        join(OUT_DIR, 'RepeatMasker', '{genome}_RM_TEs.dict'),
        join(OUT_DIR, 'RepeatMasker', '{genome}_RM_TEs.fasta.fai')
    log:
        join(OUT_DIR, 'Logs', 'seqDictionary', '{genome}_RM.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'seqDictionary', '{genome}_RM.benchmark.tsv')
    threads: 
        4
    conda:
        'envs/atac_yablab.yml'
    message:
        """--- Creating sequence dictionary for {wildcards.genome} RM genome. """
    shell:
        'picard CreateSequenceDictionary'
                ' -R {input.fasta}'
                ' > {log} 2>&1'
        ' && samtools faidx {input.fasta}'

