rule multiQC:
    input:
        expand(join(OUT_DIR, 'fastQC', '{sample}.R1_fastqc.html'), sample = SAMPLES),
        expand(join(OUT_DIR, 'fastQC', '{sample}.1_fastqc.html'), sample = SAMPLES),
        expand(join(OUT_DIR, 'trimmed_reads', '{sample}.qc.txt'), sample = SAMPLES),
        expand(join(OUT_DIR, 'Logs', 'hisat2', 'hisat2_{sample}_{genome}.log'), sample = SAMPLES, genome = config['genomes']),
        expand(join(OUT_DIR, 'Logs', 'hisat2', 'hisat2_{sample}_{genome}_RM.log'), sample = SAMPLES, genome = config['genomes']),
        expand(join(OUT_DIR, 'Logs', 'qualimap', 'qualmap_{sample}_{genome}.log'), sample = SAMPLES, genome = config['genomes']),
        expand(join(OUT_DIR, 'Logs', 'abundances', '{genome}_fC.log'), genome = config['genomes']),
        expand(join(OUT_DIR, 'Logs', 'abundances_RM', '{genome}_RM_fC.log'), genome = config['genomes'])
    output:
        join(OUT_DIR, 'MultiQC', 'multiqc_report.html')
    params:
        summary_files = join(OUT_DIR, 'MultiQC', 'summary_files.txt'),
        fastQC = join(OUT_DIR, 'fastQC', '*fastqc.zip'),
        trimmed_reads = join(OUT_DIR, 'trimmed_reads', '*qc.txt'),
        hisat2 = join(OUT_DIR, 'Logs', 'hisat2', 'hisat2_*log'),
        qualimap = join(OUT_DIR, 'QC', '*', '*_qualimap'),
        abundances = join(OUT_DIR, 'abundances*', '*', '*summary'),
        out_dir = join(OUT_DIR, 'MultiQC'),
    log:
        join(OUT_DIR, 'MultiQC', 'multiQC.log')
    benchmark:
        join(OUT_DIR, 'MultiQC', 'multiQC.benchmark.tsv')
    conda:
        'envs/rnaseq_yablab.yml'
    message:
        """--- Running MultiQC """
    shell:
        """
        ls -1 {params.fastQC} >> {params.summary_files}
        ls -1 {params.trimmed_reads} >> {params.summary_files}
        ls -1 {params.hisat2} >> {params.summary_files}
        ls -1 {params.qualimap} | grep ":" | sed "s/://g" >> {params.summary_files}
        ls -1 {params.abundances} >> {params.summary_files}
        multiqc -f -o {params.out_dir} -l {params.summary_files} > {log} 2>&1
        """
