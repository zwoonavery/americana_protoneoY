    output:
        join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.hisat2.bam.bai'),
    log:
        join(OUT_DIR, 'Logs', 'samtools_index', '{sample}_{genome}.log'),
    params:
        extra="",  # optional params string
    threads: 4  # This value - 1 will be sent to -@
    wrapper:
        "v3.1.0/bio/samtools/index"

