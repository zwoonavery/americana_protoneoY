## measure transcript abundances with Stringtie
rule featureCounts:
    input:
        hbams = expand(join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.hisat2.bam'), sample = SAMPLES, genome = config['genomes']),
        mrgd = join(OUT_DIR, 'StringTie', '{genome}', 'stringtie_merged.gtf')
    output:
        countsSt = join(OUT_DIR, 'abundances', '{genome}', 'stringtie_gene_counts.txt'),
        countsStMatrix = join(OUT_DIR, 'abundances', '{genome}', 'stringtie_gene_counts_matrix.txt')
    params:
        hbam_dir = join(OUT_DIR, 'HISAT-2', '{wildcards.genome}', '*.csorted.hisat2.bam'),
    log:
        join(OUT_DIR, 'Logs', 'abundances', '{genome}_fC.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'abundances', '{genome}_fC.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    conda:
        'envs/rnaseq_yablab.yml'
    message:
        """--- Outputting gene counts with featureCounts for {wildcards.genome} genome mapping. """
    shell:
        """
        featureCounts -a {input.mrgd} -p -T {threads} -F GTF -o {output.countsSt} {params.hbam_dir} > {log} 2>&1
        cat {output.countsSt} | cut -f 1,7- | sed 1d > {output.countsStMatrix}
        """

##--------------------------------------------------------------------------------------##
##--------------------------------------------------------------------------------------##

rule featureCounts_RM:
    input:
        bams = expand(join(OUT_DIR, 'HISAT-2', '{genome}', '{sample}_{genome}.csorted.RM.hisat2.bam'), sample = SAMPLES, genome = config['genomes']),
        gtf = join(OUT_DIR, 'RepeatMasker', '{genome}_RM_TEs.gtf')
    output:
        countsSt = join(OUT_DIR, 'abundances_RM', '{genome}', 'stringtie_RM_gene_counts.txt'),
        countsStMatrix = join(OUT_DIR, 'abundances_RM', '{genome}', 'stringtie_RM_gene_counts_matrix.txt')
    params:
        bam_dir = join(OUT_DIR, 'HISAT-2', '{wildcards.genome}', '*.csorted.RM.hisat2.bam')
    log:
        join(OUT_DIR, 'Logs', 'abundances_RM', '{genome}_RM_fC.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'abundances_RM', '{genome}_RM_fC.benchmark.tsv')
    threads:
        8
    resources:
        mem_mb=16000
    conda:
        'envs/rnaseq_yablab.yml'
    message:
        """--- Outputting gene counts with featureCounts for repeat-masked {wildcards.genome} genome mapping. """
    shell:
        """
        featureCounts -a {input.gtf} -p -T {threads} -F GTF -o {output.countsSt} {params.bam_dir} > {log} 2>&1
        cat {output.countsSt} | cut -f 1,7- | sed 1d > {output.countsStMatrix}
        """

